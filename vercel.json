{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "^toogo\\.store$"
        }
      ],
      "destination": "https://www.toogo.store/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawler|spider|crawling|Facebot|FacebookBot|facebookexternalhit|facebookcatalog|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|Pinterestbot|SkypeUriPreview|Googlebot|GPTBot|OAI-SearchBot|ChatGPT-User|ClaudeBot|Claude-User|Claude-SearchBot|PerplexityBot|Perplexity-User|Applebot|Amazonbot|Bytespider|MistralAI-User|DuckAssistBot|Google-Extended).*"
        }
      ],
      "destination": "https://herqxhfmsstbteahhxpr.supabase.co/functions/v1/store-seo-handler?path=/"
    },
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawler|spider|crawling|Facebot|FacebookBot|facebookexternalhit|facebookcatalog|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|Pinterestbot|SkypeUriPreview|Googlebot|GPTBot|OAI-SearchBot|ChatGPT-User|ClaudeBot|Claude-User|Claude-SearchBot|PerplexityBot|Perplexity-User|Applebot|Amazonbot|Bytespider|MistralAI-User|DuckAssistBot|Google-Extended).*"
        }
      ],
      "destination": "https://herqxhfmsstbteahhxpr.supabase.co/functions/v1/blog-seo-handler?path=/blog/:slug"
    },
    {
      "source": "/blog/:slug/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(bot|crawler|spider|crawling|Facebot|FacebookBot|facebookexternalhit|facebookcatalog|Twitterbot|LinkedInBot|WhatsApp|Slackbot|TelegramBot|Discordbot|Pinterestbot|SkypeUriPreview|Googlebot|GPTBot|OAI-SearchBot|ChatGPT-User|ClaudeBot|Claude-User|Claude-SearchBot|PerplexityBot|Perplexity-User|Applebot|Amazonbot|Bytespider|MistralAI-User|DuckAssistBot|Google-Extended).*"
        }
      ],
      "destination": "https://herqxhfmsstbteahhxpr.supabase.co/functions/v1/blog-seo-handler?path=/blog/:slug/"
    },
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "query",
          "key": "preview",
          "value": "crawler"
        }
      ],
      "destination": "https://herqxhfmsstbteahhxpr.supabase.co/functions/v1/blog-seo-handler?path=/blog/:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://herqxhfmsstbteahhxpr.supabase.co/functions/v1/generate-sitemap"
    },
    {
      "source": "/((?!robots\\.txt|assets/).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
