      "destination": "/api/prerender?fn=blog-seo-handler&path=/blog/:slug/"
    },
    {
      "source": "/blog/:slug",
      "has": [
        {
          "type": "query",
          "key": "preview",
          "value": "crawler"
        }
      ],
      "destination": "/api/prerender?fn=blog-seo-handler&path=/blog/:slug"
    },
    {
      "source": "/sitemap.xml",
      "destination": "/api/prerender?fn=generate-sitemap"
    },
    {
      "source": "/((?!robots\\.txt|llms\\.txt|llms-full\\.txt|b84560c66e5374c7e15ddf4bc5bd1090\\.txt|assets/|api/).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/landing.html",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*).png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
      "source": "/assets/(.*).jpg",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=86400, stale-while-revalidate=604800" }
      ]
    },
    {
